{
  "name": "@traefik-labs/faency",
  "description": "Traefik Labs design system",
  "version": "1.0.0-semantic-release",
  "license": "Apache-2.0",
  "keywords": [
    "traefiklabs",
    "ui",
    "design system",
    "react",
    "radix-ui",
    "a11y"
  ],
  "main": "dist/index.js",
  "type": "module",
  "modulesDir": "dist",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/prism-extend.*",
    "**/*.css"
  ],
  "types": "dist/index.d.ts",
  "homepage": "https://traefik.github.io/faency/",
  "repository": "https://github.com/traefik/faency",
  "bugs": {
    "url": "https://github.com/traefik/faency/issues"
  },
  "scripts": {
    "prettier": "prettier --write .",
    "build": "vite build",
    "lint": "eslint \"./components/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"./components/**/*.{ts,tsx}\"",
    "release": "yarn build && np",
    "storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider storybook dev -p 6006 -h localhost",
    "storybook-docs": "storybook dev --docs",
    "build-storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider storybook build",
    "test": "jest --watch",
    "test:ci": "jest --ci --silent",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/colors": "2.1.0",
    "@radix-ui/react-accessible-icon": "1.1.11",
    "@radix-ui/react-accordion": "1.2.16",
    "@radix-ui/react-alert-dialog": "1.1.19",
    "@radix-ui/react-aspect-ratio": "1.1.11",
    "@radix-ui/react-avatar": "1.2.2",
    "@radix-ui/react-checkbox": "1.3.7",
    "@radix-ui/react-context-menu": "2.3.3",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-id": "1.1.2",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-navigation-menu": "1.2.18",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-portal": "1.1.13",
    "@radix-ui/react-progress": "1.1.12",
    "@radix-ui/react-radio-group": "1.4.3",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slider": "1.4.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-toggle": "1.1.14",
    "@radix-ui/react-toggle-group": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.12",
    "@radix-ui/react-use-layout-effect": "1.1.2",
    "@radix-ui/react-visually-hidden": "1.2.7",
    "@rehookify/datepicker": "6.6.8",
    "@stitches/react": "1.2.8",
    "@vanilla-extract/css": "1.21.1",
    "@vanilla-extract/dynamic": "2.1.5",
    "@vanilla-extract/recipes": "0.5.7",
    "date-fns": "4.4.0",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "tinycolor2": "1.6.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/addon-links": "10.5.2",
    "@storybook/builder-vite": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "24.13.3",
    "@types/prismjs": "1.26.6",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/tinycolor2": "1.4.6",
    "@vanilla-extract/vite-plugin": "5.2.5",
    "@vitejs/plugin-react": "6.0.3",
    "@vueless/storybook-dark-mode": "10.0.8",
    "babel-jest": "30.4.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "cross-env": "10.1.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.5.2",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.0.8",
    "np": "11.2.2",
    "patch-package": "8.0.1",
    "prettier": "3.9.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semantic-release": "25.0.7",
    "storybook": "10.5.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vite-plugin-dts": "4.5.4"
  },
  "resolutions": {
    "js-yaml@4.1.0": "4.1.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md}": "prettier --write"
  },
  "release": {
    "branches": [
      "master",
      "next"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "provenance": true
        }
      ],
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
